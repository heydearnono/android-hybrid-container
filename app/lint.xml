<?xml version="1.0" encoding="utf-8"?>
<!-- 抑制一律按路径写，不在 convention plugin 里全局 disable -->
<lint>
    <!--
      自适应图标必须留在 mipmap-anydpi-v26。minSdk 已经 37，ObsoleteSdkInt 会建议合并到 mipmap-anydpi，
      但实测那样 AAPT 找不到 mipmap/ic_launcher，构建直接失败。
    -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26/ic_launcher.xml" />
    </issue>

    <!--
      values-zh 只为「应用名叫螃蟹」而存在。错误界面那两条 pro 定死了中文原文、要求三端一字不差，
      所以刻意只留 values/ 那一份；MissingTranslation 会因此报缺 zh 翻译，抑制掉它，别为了让 lint 闭嘴
      而在 values-zh 里复制一份同样的字（那会变成两处定义，改一处就漏）。
    -->
    <issue id="MissingTranslation">
        <ignore path="src/main/res/values/strings.xml" />
    </issue>
</lint>
