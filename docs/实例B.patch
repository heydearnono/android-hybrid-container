@@ -0,0 +1,163 @@
+package net.xiaoluzhu.crab
+
+import android.app.Activity
+import android.content.Intent
+import android.net.Uri
+import android.util.Log
+import android.webkit.WebSettings
+import android.webkit.WebView
+import net.xiaoluzhu.crab.container.CrabLog
+import net.xiaoluzhu.crab.container.UserAgent
+import net.xiaoluzhu.crab.container.WebSettingsSpec
+import net.xiaoluzhu.crab.webview.CrabContainer
+import java.io.File
+
+/**
+ * **临时代码**：加载后生效差异表的实例 B（docs/RUNBOOK.md「七」）。跑完 `git apply -R docs/实例B.patch`，
+ * 一行都不留。
+ *
+ * 一次只翻一项：冷启动时带 `--es crab.b <项>`，那一项设成相反值、其余照取值表，然后才加载入口页。不带就是
+ * 实例 A（全部取目标值），文件访问那一行的基线就这么取。之后的动作都经 `--es crab.b.cmd <动作>` 走
+ * `onNewIntent` 进来（宿主是 singleTask，`am start` 不会多开），每个动作打一行 `CRAB-ENV B`，与 logcat
+ * 里别的行落在同一条时间线上。
+ */
+internal object InstanceB {
+    private const val EXTRA_ITEM = "crab.b"
+    private const val EXTRA_CMD = "crab.b.cmd"
+
+    /** 放在 filesDir：`setAllowFileAccess` 管不到 `android_asset` / `android_res`，放那里两档都打得开。 */
+    private const val FILE_NAME = "crab-b.html"
+    private const val FILE_BODY =
+        "<!DOCTYPE html><meta charset=\"utf-8\"><title>CRAB-B-FILE</title><h1>CRAB-B-FILE 打开了</h1>" +
+            "<script>console.log('CRAB-ENV B file opened ' + location.href)</script>"
+
+    /** 每项一段观察脚本，`probe` 动作经 `evaluateJavascript` 跑。它不带用户手势，自动播放那项要的就是这个。 */
+    private val PROBES =
+        mapOf(
+            "js" to "document.getElementById('env').textContent = 'B js ran'; console.log('CRAB-ENV B js ran')",
+            "storage" to
+                "try { localStorage.setItem('crab.b', '1'); console.log('CRAB-ENV B storage ok') }" +
+                " catch (e) { console.log('CRAB-ENV B storage threw ' + e) }",
+            "mixed" to
+                "(function () { var i = new Image();" +
+                " i.onload = function () { console.log('CRAB-ENV B mixed loaded') };" +
+                " i.onerror = function () { console.log('CRAB-ENV B mixed blocked') };" +
+                " i.src = 'http://10.0.2.2:8000/probe.png?t=' + Date.now(); })()",
+            "autoplay" to
+                "(function () { var v = document.createElement('video'); v.src = 'tone.wav';" +
+                " v.autoplay = true; v.loop = true;" +
+                " v.addEventListener('playing', function () { console.log('CRAB-ENV B autoplay playing') });" +
+                " document.body.appendChild(v);" +
+                " setTimeout(function () { console.log('CRAB-ENV B autoplay paused=' + v.paused) }, 2000); })()",
+            "zoom" to "console.log('CRAB-ENV B zoom scale=' + window.visualViewport.scale)",
+            "ua" to "console.log('CRAB-ENV B ua ' + navigator.userAgent)",
+        )
+
+    private var item: String? = null
+
+    fun beforeFirstLoad(
+        activity: Activity,
+        intent: Intent,
+        webView: WebView,
+    ) {
+        File(activity.filesDir, FILE_NAME).writeText(FILE_BODY)
+        item = intent.getStringExtra(EXTRA_ITEM)
+        item?.let { webView.settings.flip(activity, it, opposite = true) }
+        log("start item=$item ${webView.settings.describe()}")
+    }
+
+    fun onCommand(
+        activity: Activity,
+        intent: Intent,
+        container: CrabContainer,
+    ) {
+        val cmd = intent.getStringExtra(EXTRA_CMD) ?: return
+        val webView = container.webView
+        log("cmd=$cmd item=$item")
+        when (cmd) {
+            "target" -> {
+                item?.let { webView.settings.flip(activity, it, opposite = false) }
+                log("after target ${webView.settings.describe()}")
+            }
+
+            "reload" -> {
+                webView.reload()
+            }
+
+            "probe" -> {
+                webView.evaluateJavascript(PROBES[item] ?: "console.log('CRAB-ENV B no probe for $item')") {
+                    log("probe returned $it")
+                }
+            }
+
+            // 原生 loadUrl 不经 shouldOverrideUrlLoading（WebViewClient 的 javadoc 原文），闸门因此不拦；
+            // 这一跳之后 crab.txt 里没有 CRAB-NAV 行，就是没被拦的证据。
+            "file" -> {
+                webView.loadUrl(Uri.fromFile(File(activity.filesDir, FILE_NAME)).toString())
+            }
+
+            // 回探针页。走重试那条路：打不开时容器在错误态，只 loadUrl 不会把界面切回来。
+            "entry" -> {
+                container.onRetry()
+            }
+
+            else -> {
+                log("unknown cmd $cmd")
+            }
+        }
+    }
+
+    private fun WebSettings.flip(
+        activity: Activity,
+        item: String,
+        opposite: Boolean,
+    ) {
+        when (item) {
+            "js" -> {
+                javaScriptEnabled = WebSettingsSpec.JAVA_SCRIPT_ENABLED != opposite
+            }
+
+            "storage" -> {
+                domStorageEnabled = WebSettingsSpec.DOM_STORAGE_ENABLED != opposite
+            }
+
+            "mixed" -> {
+                mixedContentMode =
+                    if (opposite) WebSettings.MIXED_CONTENT_ALWAYS_ALLOW else WebSettings.MIXED_CONTENT_NEVER_ALLOW
+            }
+
+            "file" -> {
+                allowFileAccess = WebSettingsSpec.ALLOW_FILE_ACCESS != opposite
+            }
+
+            "autoplay" -> {
+                mediaPlaybackRequiresUserGesture = WebSettingsSpec.MEDIA_PLAYBACK_REQUIRES_USER_GESTURE != opposite
+            }
+
+            "zoom" -> {
+                setSupportZoom(WebSettingsSpec.SUPPORT_ZOOM != opposite)
+                builtInZoomControls = WebSettingsSpec.BUILT_IN_ZOOM_CONTROLS != opposite
+                // 文字缩放没有「相反值」，取 200：变没变一眼看得出
+                textZoom = if (opposite) 200 else WebSettingsSpec.TEXT_ZOOM
+            }
+
+            "ua" -> {
+                val system = WebSettings.getDefaultUserAgent(activity)
+                userAgentString = if (opposite) system else UserAgent.decorate(system, BuildConfig.VERSION_NAME)
+            }
+
+            else -> {
+                log("unknown item $item")
+            }
+        }
+    }
+
+    private fun WebSettings.describe(): String =
+        "js=$javaScriptEnabled storage=$domStorageEnabled mixed=$mixedContentMode file=$allowFileAccess " +
+            "gesture=$mediaPlaybackRequiresUserGesture zoom=${supportZoom()}/$builtInZoomControls/$textZoom " +
+            "ua=$userAgentString"
+
+    private fun log(line: String) {
+        Log.i(CrabLog.TAG, "CRAB-ENV B $line")
+    }
+}
